# Multi-stage build für optimale Image-Größe
FROM node:20-alpine AS build

WORKDIR /app

# Build-Zeit Environment Variables
ARG VITE_API_URL
ARG VITE_SIGNALR_HUB_URL
ARG VITE_TILE_URL
ARG VITE_TILE_ATTRIBUTION

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SIGNALR_HUB_URL=${VITE_SIGNALR_HUB_URL}
ENV VITE_TILE_URL=${VITE_TILE_URL}
ENV VITE_TILE_ATTRIBUTION=${VITE_TILE_ATTRIBUTION}

# Dependencies installieren
COPY package*.json ./
RUN npm ci

# Source Code kopieren und bauen
COPY . .
RUN npm run build

# Production stage mit nginx
FROM nginx:alpine

# Nginx Konfiguration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Build Dateien kopieren
COPY --from=build /app/dist /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
