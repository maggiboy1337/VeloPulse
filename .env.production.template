# Production Environment Variables
# WICHTIG: Kopieren Sie diese Datei als .env.production und füllen Sie sichere Werte ein!

# PostgreSQL Database
POSTGRES_DB=livetracking
POSTGRES_USER=velopulse_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# JWT Settings
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHARACTER_STRING
JWT_ISSUER=VeloPulse
JWT_AUDIENCE=VeloPulse

# CORS Origins (Ihre Domain/IP)
CORS_ORIGINS=http://ihre-domain.de:8080

# Backend API URL (für Frontend Build)
VITE_API_URL=https://ihre-domain.de/api
